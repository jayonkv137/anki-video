# anki-video environment template
# Policy: JUST-IN-TIME provisioning — each key is added (here as placeholder,
# in .env as real value) at the build step that first needs it.
# Copy to .env and fill in as services get provisioned. .env is git-ignored.

# --- Story generation (component #3) ---
# ANTHROPIC_API_KEY=

# --- Video/audio generation (components #4/#5 — after prototyping decision) ---
# FAL_KEY=
# GOOGLE_API_KEY=
# ELEVENLABS_API_KEY=

# --- Assembly (component #6) ---
# CREATOMATE_API_KEY=

# --- Data spine (components #7/#9) --- (provisioned 2026-07-13)
# Supabase's current key naming: publishable = low-privilege (client/app),
# secret = admin (pipeline/n8n/scripts only — never in the app, never committed).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Gemini Model Selection ---
GEMINI_MODEL=gemini-3.6-flash

